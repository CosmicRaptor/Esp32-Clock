{
  "_comment": "Which face shows when. Run by tests/test_faces.py (Python) and tests/js/face-rules.test.js (JS). `now` is the clock's local time, weekday 0 = Sunday. The firmware should pass the same cases.",
  "matches": [
    {"name": "no constraints never matches", "when": {"hours": null, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 12, "weekday": 6}, "match": false},
    {"name": "hours inside", "when": {"hours": {"from": 9, "to": 17}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 9, "weekday": 6}, "match": true},
    {"name": "hours end is exclusive", "when": {"hours": {"from": 9, "to": 17}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 17, "weekday": 6}, "match": false},
    {"name": "hours before start", "when": {"hours": {"from": 9, "to": 17}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 8, "weekday": 6}, "match": false},
    {"name": "hours wrap: late evening", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 23, "weekday": 6}, "match": true},
    {"name": "hours wrap: after midnight", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 5, "weekday": 6}, "match": true},
    {"name": "hours wrap: the start hour itself", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 22, "weekday": 6}, "match": true},
    {"name": "hours wrap: the end hour is out", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 6, "weekday": 6}, "match": false},
    {"name": "hours wrap: midday is out", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 12, "weekday": 6}, "match": false},
    {"name": "to 24 reaches the end of the day", "when": {"hours": {"from": 18, "to": 24}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 23, "weekday": 6}, "match": true},
    {"name": "from 0 starts at midnight", "when": {"hours": {"from": 0, "to": 6}, "months": [], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 0, "weekday": 6}, "match": true},
    {"name": "month in list", "when": {"hours": null, "months": [12, 1, 2], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 1, "day": 7, "hour": 12, "weekday": 3}, "match": true},
    {"name": "month not in list", "when": {"hours": null, "months": [12, 1, 2], "weekdays": [], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 12, "weekday": 6}, "match": false},
    {"name": "weekday in list (Sunday = 0)", "when": {"hours": null, "months": [], "weekdays": [0, 6], "dates": []}, "now": {"year": 2026, "month": 11, "day": 8, "hour": 12, "weekday": 0}, "match": true},
    {"name": "weekday not in list", "when": {"hours": null, "months": [], "weekdays": [0, 6], "dates": []}, "now": {"year": 2026, "month": 11, "day": 9, "hour": 12, "weekday": 1}, "match": false},
    {"name": "yearly date matches any year", "when": {"hours": null, "months": [], "weekdays": [], "dates": [{"month": 2, "day": 14, "year": null}]}, "now": {"year": 2031, "month": 2, "day": 14, "hour": 0, "weekday": 5}, "match": true},
    {"name": "one-off date matches that year", "when": {"hours": null, "months": [], "weekdays": [], "dates": [{"month": 11, "day": 7, "year": 2026}]}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 3, "weekday": 6}, "match": true},
    {"name": "one-off date does not match next year", "when": {"hours": null, "months": [], "weekdays": [], "dates": [{"month": 11, "day": 7, "year": 2026}]}, "now": {"year": 2027, "month": 11, "day": 7, "hour": 3, "weekday": 0}, "match": false},
    {"name": "any of several dates", "when": {"hours": null, "months": [], "weekdays": [], "dates": [{"month": 2, "day": 14, "year": null}, {"month": 12, "day": 25, "year": null}]}, "now": {"year": 2026, "month": 12, "day": 25, "hour": 8, "weekday": 5}, "match": true},
    {"name": "different day of the date's month", "when": {"hours": null, "months": [], "weekdays": [], "dates": [{"month": 12, "day": 25, "year": null}]}, "now": {"year": 2026, "month": 12, "day": 24, "hour": 8, "weekday": 4}, "match": false},
    {"name": "all constraints must hold: night on weekends", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [0, 6], "dates": []}, "now": {"year": 2026, "month": 11, "day": 7, "hour": 23, "weekday": 6}, "match": true},
    {"name": "all constraints must hold: right hour, wrong day", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [0, 6], "dates": []}, "now": {"year": 2026, "month": 11, "day": 9, "hour": 23, "weekday": 1}, "match": false},
    {"name": "all constraints must hold: december nights on Christmas", "when": {"hours": {"from": 18, "to": 24}, "months": [12], "weekdays": [], "dates": [{"month": 12, "day": 25, "year": null}]}, "now": {"year": 2026, "month": 12, "day": 25, "hour": 19, "weekday": 5}, "match": true}
  ],
  "picks": [
    {"name": "nothing at all", "faces": [], "default": "", "pinned": "", "now": {"year": 2026, "month": 11, "day": 7, "hour": 12, "weekday": 6}, "expect": null},
    {"name": "no face matches and no default: the built-in face", "faces": [{"id": "night", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [], "dates": []}}], "default": "", "pinned": "", "now": {"year": 2026, "month": 11, "day": 7, "hour": 12, "weekday": 6}, "expect": null},
    {"name": "no match: the default", "faces": [{"id": "night", "when": {"hours": {"from": 22, "to": 6}, "months": [], "weekdays": [], "dates": []}}, {"id": "day", "when": {"hours": null, "months": [], "weekdays": [], "dates": []}}], "default": "day", "pinned": "", "now": {"year": 2026, "month": 11, "day": 7, "hour": 12, "weekday": 6}, "expect": "day"},
    {"name": "earlier face wins", "faces": [{"id": "valentine", "when": {"hours": null, "months": [], "weekdays": [], "dates": [{"month": 2, "day": 14, "year": null}]}}, {"id": "winter", "when": {"hours": null, "months": [12, 1, 2], "weekdays": [], "dates": []}}], "default": "", "pinned": "", "now": {"year": 2026, "month": 2, "day": 14, "hour": 12, "weekday": 6}, "expect": "valentine"},
    {"name": "order matters: same faces, other order", "faces": [{"id": "winter", "when": {"hours": null, "months": [12, 1, 2], "weekdays": [], "dates": []}}, {"id": "valentine", "when": {"hours": null, "months": [], "weekdays": [], "dates": [{"month": 2, "day": 14, "year": null}]}}], "default": "", "pinned": "", "now": {"year": 2026, "month": 2, "day": 14, "hour": 12, "weekday": 6}, "expect": "winter"},
    {"name": "pinned beats a match", "faces": [{"id": "winter", "when": {"hours": null, "months": [12, 1, 2], "weekdays": [], "dates": []}}, {"id": "cafe", "when": {"hours": null, "months": [], "weekdays": [], "dates": []}}], "default": "", "pinned": "cafe", "now": {"year": 2026, "month": 1, "day": 3, "hour": 12, "weekday": 6}, "expect": "cafe"},
    {"name": "a pin that no longer exists is ignored", "faces": [{"id": "winter", "when": {"hours": null, "months": [12, 1, 2], "weekdays": [], "dates": []}}], "default": "", "pinned": "gone", "now": {"year": 2026, "month": 1, "day": 3, "hour": 12, "weekday": 6}, "expect": "winter"},
    {"name": "a default that no longer exists is ignored", "faces": [], "default": "gone", "pinned": "", "now": {"year": 2026, "month": 1, "day": 3, "hour": 12, "weekday": 6}, "expect": null}
  ]
}
